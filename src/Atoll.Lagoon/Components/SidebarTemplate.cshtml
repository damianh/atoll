@inherits Atoll.Components.AtollSlice<Atoll.Lagoon.Components.SidebarModel>
@{WriteLiteral($"<nav aria-label=\"{Model.NavLabel}\" data-hash=\"{Model.Hash}\">");}
<script src="/scripts/atoll-sidebar-restore.js"></script>
<ul>
    @foreach (var item in Model.Items)
    {
        if (item.IsGroup)
        {
            <li class="sidebar-group-item">
                @{
                    await RenderComponentAsync<Atoll.Lagoon.Components.SidebarGroup>(
                        new Dictionary<string, object?>
                        {
                            ["Group"] = item,
                            ["ChevronPosition"] = Model.ChevronPosition,
                            ["Counter"] = Model.Counter,
                        });
                }
            </li>
        }
        else
        {
            await RenderComponentAsync<Atoll.Lagoon.Components.SidebarLink>(
                new Dictionary<string, object?> { ["Item"] = item });
        }
    }
</ul>
<script src="/scripts/atoll-sidebar-scroll-restore.js"></script>
@{WriteLiteral("</nav>");}

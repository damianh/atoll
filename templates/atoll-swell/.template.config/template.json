{
  "$schema": "http://json.schemastore.org/template",
  "author": "Atoll Contributors",
  "classifications": ["Web", "Atoll", "Slides", "Presentation"],
  "identity": "Atoll.Templates.Swell",
  "name": "Atoll Swell Slides",
  "shortName": "atoll-swell",
  "description": "A slide deck project powered by Atoll.Swell — Markdown-driven presentations with .NET.",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "AtollSwell",
  "preferNameDirectory": true,
  "symbols": {
    "framework": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "net10.0",
      "choices": [
        { "choice": "net10.0", "description": ".NET 10" },
        { "choice": "net11.0", "description": ".NET 11" }
      ],
      "replaces": "net10.0"
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "exclude": ["bin/**", "obj/**", ".template.config/**"]
        }
      ]
    }
  ]
}

{
  "$schema": "http://json.schemastore.org/template",
  "author": "Atoll Contributors",
  "classifications": ["Web", "Atoll"],
  "identity": "Atoll.Templates.Starter",
  "name": "Atoll Starter Project",
  "shortName": "atoll-starter",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "AtollStarter",
  "preferNameDirectory": true,
  "symbols": {
    "framework": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "net10.0",
      "choices": [
        { "choice": "net10.0", "description": ".NET 10" },
        { "choice": "net11.0", "description": ".NET 11" }
      ],
      "replaces": "net10.0"
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "exclude": ["bin/**", "obj/**", ".template.config/**"]
        }
      ]
    }
  ]
}

<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Markdown -->
    <PackageVersion Include="Markdig" Version="1.3.2" />
    <!-- HTML Parsing -->
    <PackageVersion Include="AngleSharp" Version="1.7.2" />
    <!-- Syntax Highlighting -->
    <PackageVersion Include="TextMateSharp.Grammars" Version="2.0.4" />
    <!-- YAML -->
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
    <!-- JS/CSS Minification -->
    <PackageVersion Include="NUglify" Version="1.22.4" />
    <!-- CLI -->
    <PackageVersion Include="System.CommandLine" Version="2.0.11" />
    <!-- Razor Slices -->
    <PackageVersion Include="RazorSlices" Version="0.11.3" />
    <!-- Hashing -->
    <PackageVersion Include="System.IO.Hashing" Version="10.0.11" />
    <!-- Image generation -->
    <PackageVersion Include="SkiaSharp" Version="4.151.1" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="4.151.1" />
    <!-- Versioning -->
    <PackageVersion Include="MinVer" Version="7.0.0" />
    <!-- Export -->
    <PackageVersion Include="Microsoft.Playwright" Version="1.62.0" />
    <PackageVersion Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <!-- Testing -->
    <PackageVersion Include="xunit.v3.core.mtp-v2" Version="4.0.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <!-- Aspire -->
    <PackageVersion Include="Aspire.Hosting" Version="13.5.3" />
    <PackageVersion Include="Aspire.Hosting.Testing" Version="13.5.3" />
  </ItemGroup>
</Project>